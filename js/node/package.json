    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p test/types"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.30.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.9.3"
  }
}
