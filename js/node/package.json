{
  "name": "trustmark-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js SDK for embedding and reading TrustMark watermarks with ONNX Runtime",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
