{
  "manifest_version": 1,
  "description": "Published TrustMark model artifacts, the model family and variant of each one, and which encoders and decoders interoperate. See models/README.md.",
  "base_url": "https://cai-watermark.adobe.net/watermarking/trustmark-models/",
  "digests": {
    "computed": "2026-10-20",
    "method": "Each artifact was downloaded from its url (or read from repo_path) and size, md5 and sha256 were computed over the received bytes.",
    "status": "unconfirmed: computed by a contributor, to be confirmed by the maintainers against the files they published"
  },
  "families": {
    "trustmark": {
      "summary": "The TrustMark models published by Adobe. python/ loads the PyTorch checkpoints; rust/, cpp/ and js/ load the ONNX exports of the same variants, and so does python-hailo/ for its 'cpu' (onnxruntime) backends.",
      "name_source": "Name of the project, of the PyPI package built from python/ and of the trustmark-models/ CDN directory; the registered C2PA soft-binding algorithm ids also use the com.adobe.trustmark prefix.",
      "references": ["README.md", "python/CONFIG.md", "https://arxiv.org/abs/2311.18297"]
    },
    "trustmark-hailo": {
      "summary": "Hailo-8L NPU builds used by python-hailo/ when encoder_backend or decoder_backend is 'npu', and by its bounding-box detector. Quantized to INT8, except the P encoder which uses 16 bits.",
      "name_source": "Name of the PyPI package built from python-hailo/.",
      "references": ["python-hailo/README.md", "python-hailo/CONFIG.md"],
      "notes": [
        "python-hailo/CONFIG.md states that images encoded by the PyTorch port cannot be decoded by python-hailo/ and vice versa because its models are separately trained or quantized. This manifest records that as the status between the trustmark and trustmark-hailo families; it was not tested for lack of Hailo hardware.",
        "The python-hailo/ 'cpu' backends are not part of this family: they load the trustmark-family encoder_{V}.onnx and decoder_{V}.onnx, whose md5 values python-hailo/trustmark_hailo/trustmark_hailo.py pins. With those backends python-hailo/ and python/ decoded each other's watermarks for B, C, P and Q (see compatibility.verification), contrary to the CONFIG.md statement above.",
        "secret2image_{B,C,P,Q}.npz hold exactly the Gemm weights of the trustmark-family encoder_{V}.onnx, so the NPU encoders were compiled from those ONNX files; quantization changes the other weights."
      ]
    }
  },
  "variants": {
    "Q": {
      "summary": "Default. Good trade-off between robustness and imperceptibility; published with the 2023 paper.",
      "decoder_backbone": "ResNet-50",
      "typical_psnr_db": "43-45"
    },
    "B": {
      "summary": "Very similar to Q; included mainly to reproduce the 2023 paper.",
      "decoder_backbone": "ResNet-50",
      "typical_psnr_db": "43-45"
    },
    "C": {
      "summary": "Compact. Smaller decoder, lower visual quality.",
      "decoder_backbone": "ResNet-18",
      "typical_psnr_db": "38-39"
    },
    "P": {
      "summary": "Perceptual. Highest visual quality, trained with a higher perceptual loss weight; always crops the center square.",
      "decoder_backbone": "ResNet-50",
      "typical_psnr_db": "48-50"
    }
  },
  "wire_format": {
    "summary": "All families and variants carry the same 100-bit packet; the decoder auto-detects the schema from the version bits.",
    "packet_bits": 100,
    "layout": "data bits, then BCH parity bits, then 4 version bits",
    "version_bits": "The last 4 bits: 2 reserved bits written as 0, then the schema id as a 2-bit integer. Decoders read only the last 2 bits.",
    "bch_polynomial": 137,
    "schemas": [
      {"id": 0, "name": "BCH_SUPER", "data_bits": 40, "ecc_bits": 56, "correctable_bit_flips": 8},
      {"id": 1, "name": "BCH_5", "data_bits": 61, "ecc_bits": 35, "correctable_bit_flips": 5},
      {"id": 2, "name": "BCH_4", "data_bits": 68, "ecc_bits": 28, "correctable_bit_flips": 4},
      {"id": 3, "name": "BCH_3", "data_bits": 75, "ecc_bits": 21, "correctable_bit_flips": 3}
    ],
    "raw_mode": "python/ with use_ECC=False embeds 100 raw bits without parity or version bits.",
    "references": ["README.md#data-schema", "python/CONFIG.md", "python/trustmark/datalayer.py"]
  },
  "c2pa_soft_binding": {
    "assertion": "c2pa.soft-binding",
    "value_format": "<schema id>*<data bits>, for example 1*0101... (c2pa/c2pa_watermark_example.py, js/tm_datalayer.js)",
    "registry": "https://github.com/c2pa-org/softbinding-algorithm-list",
    "registry_checked": {"date": "2026-10-20", "commit": "5d5f99f97049627758fa3214822140eaa992af11"},
    "registered": [
      {"model_family": "trustmark", "variant": "Q", "alg": "com.adobe.trustmark.Q", "registry_identifier": 4},
      {"model_family": "trustmark", "variant": "C", "alg": "com.adobe.trustmark.C", "registry_identifier": 5},
      {"model_family": "trustmark", "variant": "P", "alg": "com.adobe.trustmark.P", "registry_identifier": 13}
    ],
    "notes": [
      "The registry has no entry for variant B.",
      "Registry entries name a TrustMark variant, not a model family. This manifest assigns no algorithm id to trustmark-hailo."
    ]
  },
  "preprocessing": {
    "common": {
      "color": "RGB",
      "layout": "NCHW",
      "dtype": "float32",
      "value_range": [-1.0, 1.0],
      "normalization": "pixel / 127.5 - 1 for 8-bit pixels",
      "crop": "If the long side is more than twice the short side, use the centered square whose side is the short side, otherwise use the whole image. Variant P always uses the centered square.",
      "resample": "bilinear",
      "encoder_input_size": 256,
      "encoder_output": "Watermarked image in [-1, 1]. Implementations take residual = output - input, resize the residual to the cropped region and add it to the original pixels.",
      "bit_decision": "Packet bit i is 1 when decoder output i is positive. rust/, cpp/ and js/ also map an output of exactly 0 to 1."
    },
    "variants": {
      "B": {
        "crop_always_center_square": false,
        "decoder_input_size": {"pytorch": 245, "onnx": 256},
        "decoder_network_size": 224,
        "strength_multiplier": 1.0
      },
      "C": {
        "crop_always_center_square": false,
        "decoder_input_size": {"pytorch": 245, "onnx": 256},
        "decoder_network_size": 224,
        "strength_multiplier": 1.0
      },
      "P": {
        "crop_always_center_square": true,
        "decoder_input_size": {"pytorch": 224, "onnx": 224},
        "decoder_network_size": 224,
        "strength_multiplier": 1.25
      },
      "Q": {
        "crop_always_center_square": false,
        "decoder_input_size": {"pytorch": 245, "onnx": 256},
        "decoder_network_size": 224,
        "strength_multiplier": 1.0
      }
    },
    "decoder_internal_resize": "The decoder network runs at 224x224. SecretDecoder.forward (python/trustmark/unet.py) resizes larger inputs to 224x224 with bilinear interpolation (align_corners=False, no antialiasing); the B, C and Q ONNX decoders contain the same step as a Resize node (mode linear, half_pixel coordinates). python/ feeds 245x245 images to the PyTorch decoders while the ONNX decoders take 256x256 (cpp/README.md); this difference is intentional and recorded, not a defect of either file.",
    "runtimes": {
      "python": {"formats": ["pytorch-ckpt", "yaml"], "resample": "PIL Image.BILINEAR, which antialiases when downscaling"},
      "rust": {"formats": ["onnx"], "resample": "fast_image_resize bilinear"},
      "cpp": {"formats": ["onnx"], "resample": "OpenCV INTER_LINEAR"},
      "js": {
        "formats": ["onnx"],
        "roles": ["decoder"],
        "variants": ["P", "Q"],
        "resample": "resizer.onnx",
        "notes": "js/tm_watermark.js scales pixels to [0, 1] and passes the resizer output to the decoder without mapping it to [-1, 1]."
      },
      "python-hailo": {"formats": ["onnx", "hailo-hef", "npz"], "resample": "PIL Image.BILINEAR"}
    }
  },
  "compatibility": {
    "rule": "An encoder's output decodes only with a decoder of the same model_family and variant. Within the trustmark family the PyTorch checkpoint and the ONNX export of a variant are interchangeable, given the preprocessing above.",
    "pairs": [
      {
        "encoder": {"model_family": "trustmark", "variant": "B"},
        "decoder": {"model_family": "trustmark", "variant": "B"},
        "status": "supported"
      },
      {
        "encoder": {"model_family": "trustmark", "variant": "C"},
        "decoder": {"model_family": "trustmark", "variant": "C"},
        "status": "supported"
      },
      {
        "encoder": {"model_family": "trustmark", "variant": "P"},
        "decoder": {"model_family": "trustmark", "variant": "P"},
        "status": "supported"
      },
      {
        "encoder": {"model_family": "trustmark", "variant": "Q"},
        "decoder": {"model_family": "trustmark", "variant": "Q"},
        "status": "supported"
      },
      {
        "encoder": {"model_family": "trustmark-hailo", "variant": "B"},
        "decoder": {"model_family": "trustmark-hailo", "variant": "B"},
        "status": "supported",
        "source": "python-hailo/README.md"
      },
      {
        "encoder": {"model_family": "trustmark-hailo", "variant": "C"},
        "decoder": {"model_family": "trustmark-hailo", "variant": "C"},
        "status": "supported",
        "source": "python-hailo/README.md"
      },
      {
        "encoder": {"model_family": "trustmark-hailo", "variant": "P"},
        "decoder": {"model_family": "trustmark-hailo", "variant": "P"},
        "status": "supported",
        "source": "python-hailo/README.md"
      },
      {
        "encoder": {"model_family": "trustmark-hailo", "variant": "Q"},
        "decoder": {"model_family": "trustmark-hailo", "variant": "Q"},
        "status": "supported",
        "source": "python-hailo/README.md"
      }
    ],
    "unsupported": [
      {
        "case": "Encoder and decoder of different variants, in any family",
        "source": "python/CONFIG.md, python-hailo/CONFIG.md"
      },
      {
        "case": "trustmark encoder with trustmark-hailo decoder, or the reverse",
        "source": "python-hailo/CONFIG.md",
        "verified": false
      }
    ],
    "verification": [
      {
        "date": "2026-10-20",
        "pairs": "trustmark B, C, P and Q",
        "method": "BCH_5 payload embedded into images/ghost.png, images/ripley.jpg and images/ufo_240.jpg by python/ with the PyTorch encoder and, separately, with the encoder network replaced by encoder_{V}.onnx in onnxruntime; each result decoded by the PyTorch decoder (python/ preprocessing) and by decoder_{V}.onnx (ONNX input size, PIL bilinear resize).",
        "result": "payload recovered in all 48 combinations"
      },
      {
        "date": "2026-10-20",
        "pairs": "trustmark B, C, P and Q, python-hailo/ with encoder_backend and decoder_backend 'cpu'",
        "method": "python-hailo/ encoded images/ghost.png and images/ripley.jpg and python/ decoded them, and the reverse.",
        "result": "payload recovered in all 16 combinations"
      }
    ]
  },
